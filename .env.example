# Copy to .env.local and fill in. .env.local is gitignored (holds secrets).
#
# Login is NextAuth (Credentials) authenticating against admin_schema.users on
# the agentic_cvm Postgres — these DB vars must be set or every login fails with
# "Database query failed".

DB_HOST=10.200.37.142
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=agentic_cvm

NEXTAUTH_URL=http://localhost:3000
# Generate a real one:  openssl rand -hex 32
NEXTAUTH_SECRET=replace-with-a-32-byte-random-hex-string
